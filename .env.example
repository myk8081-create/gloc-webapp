# Vercel 또는 로컬 빌드에서 사용합니다.
# Apps Script 배포 후 Web App URL을 넣으세요.
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# QR/카카오톡 안내문에 들어갈 실제 서비스 주소입니다.
APP_PUBLIC_URL=https://stock.example.com

# 값을 appsScript로 두면 빌드된 앱이 Google Sheets API를 호출합니다.
DATA_MODE=appsScript

# 브라우저는 이 Vercel API Route만 호출합니다.
# 비워두면 APPS_SCRIPT_API_URL이 있을 때 빌드 시 /api/gloc으로 자동 설정됩니다.
API_BASE_URL=/api/gloc

# true로 설정한 경우에만 Apps Script URL을 프론트 config.js에 노출합니다.
EXPOSE_APPS_SCRIPT_URL=false

# 향후 Next.js Repository/Provider 계층에서 사용할 데이터 제공자입니다.
DATA_PROVIDER=googleSheets
GLOC_CUSTOMER_ID=default

# 웹앱 바로가기 푸시 알림용 키입니다. npm run generate:vapid 로 생성합니다.
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@example.com
PUSH_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
